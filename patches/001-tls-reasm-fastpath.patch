+						return VERDICT_DROP;
+					}
+					// On affected hardware DROP activates RTCACHE and later fragments bypass NFQUEUE.
+					// ACK-only placeholders keep the flow on the slow path until replay.
+					if (params.fastpath_workaround == FASTPATH_WORKAROUND_ON ||
