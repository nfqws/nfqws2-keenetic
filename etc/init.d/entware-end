start() {
  if is_running; then
    echo 'Service NFQWS2 is already running' >&2
    return 1
  fi

  validate_config || return 1
  create_running_config
  kernel_modules

  if ! $NFQWS_BIN --daemon --pidfile=$PIDFILE $(_startup_args); then
    echo 'NFQWS2 daemon exited with an error, firewall rules not installed' >&2
    return 1
  fi

  # The daemon forks and writes the pidfile itself, after loading its lists.
  # Wait for it before installing NFQUEUE rules: with --queue-bypass a daemon
  # that failed to start degrades silently - traffic keeps flowing while
  # nothing is desynced at all.
  wait_i=0
  until is_running; do
    wait_i=$((wait_i + 1))
    if [ "$wait_i" -gt 10 ]; then
      echo 'NFQWS2 daemon did not start, firewall rules not installed' >&2
      return 1
    fi
    sleep 1
  done

  firewall_iptables
  firewall_ip6tables
  system_config

  echo 'Started NFQWS2 service'
}

stop() {
  firewall_stop

  if ! is_running; then
    echo 'Service NFQWS2 is not running' >&2
    return 1
  fi

  echo 'Stopping NFQWS2 service...'
  kill -15 $(cat "$PIDFILE") && rm -f "$PIDFILE"
  remove_running_config
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status_service
    ;;
  restart)
    stop
    start
    ;;
  reload)
    reload_service
    ;;
  firewall_iptables)
    firewall_iptables
    ;;
  firewall_ip6tables)
    firewall_ip6tables
    ;;
  firewall_stop)
    firewall_stop
    ;;
  kernel_modules)
    kernel_modules
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|status}"
esac
